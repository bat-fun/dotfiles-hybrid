@import "~/.config/matugen/colors/rofi-colors.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape";
    kb-accept-entry: "Return";
}

* {
    bg:          @noir-bg;
    surface:     @noir-surface;
    surface-alt: @noir-surface-alt;
    text:        @noir-text;
    muted:       @noir-muted;
    accent:      @noir-accent;
    outline:     @noir-outline;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 10.5";
}

window {
    transparency: "real";
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 48px;
    width: 348px;

    background-color: @bg;
    border: 1px;
    border-color: @outline;
    border-radius: 16px;
    padding: 14px;
    cursor: "default";
}

mainbox {
    orientation: vertical;
    spacing: 12px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @outline;
    border-radius: 12px;
    padding: 9px 14px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
    vertical-align: 0.5;
}

entry {
    placeholder: "Quick Settings...";
    placeholder-color: @muted;
    text-color: @text;
    vertical-align: 0.5;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 9px 12px;
    border-radius: 9px;
    border: 1px;
    border-color: transparent;
    background-color: @surface;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @surface;
    border-color: transparent;
    text-color: @muted;
}

element selected.normal {
    background-color: @surface-alt;
    border-color: @accent;
    border-left: 3px;
    border-left-color: @accent;
    text-color: @text;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 10.5";
}
