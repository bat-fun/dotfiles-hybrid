@import "~/.config/matugen/colors/rofi-colors.rasi"

configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape";
    kb-accept-entry: "Return";
}

* {
    bg:          @noir-bg;
    surface:     @noir-surface;
    surface-alt: @noir-surface-alt;
    text:        @noir-text;
    muted:       @noir-muted;
    accent:      @noir-accent;
    outline:     @noir-outline;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    transparency: "real";
    width: 64%;
    height: 52%;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 1px;
    border-color: @outline;
    border-radius: 14px;
    padding: 18px;
    cursor: "default";
}

mainbox {
    orientation: vertical;
    spacing: 14px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @outline;
    border-radius: 10px;
    padding: 9px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search wallpaper...";
    placeholder-color: @muted;
    text-color: @text;
    vertical-align: 0.5;
}

listview {
    columns: 3;
    lines: 2;
    spacing: 14px;
    scrollbar: false;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    background-color: transparent;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border: 1px;
    border-color: transparent;
    border-radius: 10px;
    background-color: @surface;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @surface;
    border-color: transparent;
    text-color: @muted;
}

element selected.normal {
    background-color: @surface-alt;
    border-color: @accent;
    text-color: @text;
}

element-icon {
    size: 152px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 8px;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 9.5";
    text-color: inherit;
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 9.5";
}
