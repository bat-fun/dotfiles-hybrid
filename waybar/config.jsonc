{
  "position": "top",
  "margin": "6px 8px 0px 8px",
  "spacing": 0,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["hyprland/window", "mpris"],
  "modules-right": [
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
    "clock"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Applications",
    "on-click": "rofi -show drun -theme ~/.config/rofi/config.rasi"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "sort-by-number": true,
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "◆"
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 36,
    "separate-outputs": true,
    "on-click-right": "hyprctl dispatch togglefloating"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 28,
    "player-icons": {
      "default": "󰎈",
      "brave": "󰗃",
      "chromium": "󰗃",
      "firefox": "󰗃",
      "mpv": "󰐹",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-linked": "󱚵 Linked",
    "format-disconnected": "󰤮 Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 3,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/hypr/scripts/osd volume mute"
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c7c7bc'><b>{}</b></span>",
        "days": "<span color='#e5e2e0'><b>{}</b></span>",
        "weeks": "<span color='#919189'><b>W{}</b></span>",
        "weekdays": "<span color='#c7c7be'><b>{}</b></span>",
        "today": "<span color='#ffb4ab'><b><u>{}</u></b></span>"
      }
    }
  }
}
