{
  "layer": "top",
  "position": "top",
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 0,
  "spacing": 0,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["hyprland/window", "mpris"],
  "modules-right": ["clock", "custom/control"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Applications (Super + A)",
    "cursor": true,
    "on-click": "rofi -show drun -theme ~/.config/rofi/config.rasi"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "sort-by-number": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "◆"
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 36,
    "separate-outputs": true,
    "on-click-right": "hyprctl dispatch togglefloating"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 28,
    "cursor": true,
    "player-icons": {
      "default": "󰎈",
      "brave": "󰗃",
      "chromium": "󰗃",
      "firefox": "󰗃",
      "mpv": "󰐹",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "cursor": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c7c7bc'><b>{}</b></span>",
        "days": "<span color='#e5e2e0'>{}</span>",
        "weeks": "<span color='#919189'>W{}</span>",
        "weekdays": "<span color='#c7c7be'><b>{}</b></span>",
        "today": "<span color='#ffb4ab'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/control": {
    "exec": "~/.config/hypr/scripts/control-center --status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "cursor": true,
    "on-click": "~/.config/hypr/scripts/control-center",
    "on-click-right": "~/.config/hypr/scripts/dnd-toggle",
    "on-click-middle": "~/.config/hypr/scripts/night-light"
  }
}
