#!/usr/bin/env bash
set -Eeuo pipefail

ROFI_THEME="$HOME/.config/rofi/control-center.rasi"

refresh_waybar() {
    pkill -RTMIN+8 waybar 2>/dev/null || true
}

rofi_menu() {
    local prompt="$1"
    shift
    printf '%s\n' "$@" | rofi -dmenu -i -p "$prompt" -theme "$ROFI_THEME" || true
}

wifi_status() {
    if ! command -v nmcli >/dev/null 2>&1; then
        printf 'Unavailable'
        return
    fi
    if [[ "$(nmcli radio wifi 2>/dev/null || printf 'disabled')" != "enabled" ]]; then
        printf 'Off'
        return
    fi
    local ssid
    ssid="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
    printf '%s' "${ssid:-Disconnected}"
}

bt_status() {
    if ! command -v bluetoothctl >/dev/null 2>&1; then
        printf 'Unavailable'
        return
    fi
    if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        printf 'Off'
        return
    fi
    local dev
    dev="$(bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-)"
    printf '%s' "${dev:-On}"
}

vol_status() {
    if command -v wpctl >/dev/null 2>&1; then
        local out
        out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
        if [[ "$out" == *"[MUTED]"* ]]; then
            printf 'Muted'
        elif [[ "$out" =~ ([0-9]+\.[0-9]+) ]]; then
            awk -v v="${BASH_REMATCH[1]}" 'BEGIN{printf "%d%%", v*100}'
        else
            printf 'N/A'
        fi
    else
        printf 'N/A'
    fi
}

bright_status() {
    if command -v brightnessctl >/dev/null 2>&1; then
        local cur max
        cur="$(brightnessctl get 2>/dev/null || echo 0)"
        max="$(brightnessctl max 2>/dev/null || echo 1)"
        awk -v c="$cur" -v m="$max" 'BEGIN{if(m>0) printf "%d%%", (c/m)*100; else print "N/A"}'
    else
        printf 'N/A'
    fi
}

battery_status() {
    local bat cap stat
    for bat in /sys/class/power_supply/BAT*; do
        [[ -d "$bat" ]] || continue
        cap="$(<"$bat/capacity")"
        stat="$(<"$bat/status")"
        if [[ "$stat" == "Charging" ]]; then
            printf '%s%% (Charging)' "$cap"
        elif [[ "$stat" == "Full" ]]; then
            printf '%s%% (Full)' "$cap"
        else
            printf '%s%%' "$cap"
        fi
        return 0
    done
    return 1
}

night_status() {
    pgrep -x hyprsunset >/dev/null 2>&1 && printf 'On' || printf 'Off'
}

dnd_status() {
    if command -v dunstctl >/dev/null 2>&1 && [[ "$(dunstctl is-paused 2>/dev/null)" == "true" ]]; then
        printf 'On'
    else
        printf 'Off'
    fi
}

notif_history_count() {
    if command -v dunstctl >/dev/null 2>&1; then
        dunstctl count history 2>/dev/null || printf '0'
    else
        printf '0'
    fi
}

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
}

print_waybar_status() {
    local wifi bt vol bright night dnd bat tooltip cls="normal"
    wifi="$(wifi_status)"
    bt="$(bt_status)"
    vol="$(vol_status)"
    bright="$(bright_status)"
    night="$(night_status)"
    dnd="$(dnd_status)"

    tooltip="Quick Settings"$'\n'
    tooltip+="Wi-Fi: ${wifi}"$'\n'
    tooltip+="Bluetooth: ${bt}"$'\n'
    tooltip+="Volume: ${vol}  ·  Brightness: ${bright}"$'\n'
    if bat="$(battery_status 2>/dev/null)"; then
        tooltip+="Battery: ${bat}"$'\n'
    fi
    tooltip+="Night Light: ${night}  ·  DND: ${dnd}"$'\n'
    tooltip+=$'\n'"Click: Quick Settings  ·  Right-click: DND"

    local icon=""
    if [[ "$dnd" == "On" ]]; then
        cls="dnd"
        icon="  󰂛"
    fi

    printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
        "$icon" "$(json_escape "$tooltip")" "$cls"
}

wifi_menu() {
    command -v nmcli >/dev/null 2>&1 || return 0
    local state toggle_label choice
    state="$(nmcli radio wifi 2>/dev/null || printf 'disabled')"
    toggle_label=$([[ "$state" == "enabled" ]] && echo "󰤮  Turn Wi-Fi Off" || echo "󰤨  Turn Wi-Fi On")

    local -a items=("←  Back" "$toggle_label" "󰒓  Network Editor")
    if [[ "$state" == "enabled" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && items+=("󰤨  $line")
        done < <(nmcli -t -f ssid,signal dev wifi list --rescan no 2>/dev/null | awk -F: 'NF && $1!="" && !seen[$1]++ {printf "%s (%s%%)\n", $1, $2}' | head -n 12)
    fi

    choice="$(rofi_menu "󰤨 " "${items[@]}")"
    case "$choice" in
        ""|"←  Back") return 0 ;;
        "󰤮  Turn Wi-Fi Off") nmcli radio wifi off; refresh_waybar ;;
        "󰤨  Turn Wi-Fi On") nmcli radio wifi on; refresh_waybar ;;
        "󰒓  Network Editor") nm-connection-editor >/dev/null 2>&1 & ;;
        󰤨*)
            local ssid="${choice#󰤨  }"
            ssid="${ssid% (*}"
            nmcli dev wifi connect "$ssid" >/dev/null 2>&1 || nm-connection-editor >/dev/null 2>&1 &
            refresh_waybar
            ;;
    esac
}

bluetooth_menu() {
    command -v bluetoothctl >/dev/null 2>&1 || return 0
    local powered toggle_label choice
    powered="$(bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && echo yes || echo no)"
    toggle_label=$([[ "$powered" == "yes" ]] && echo "󰂲  Turn Bluetooth Off" || echo "󰂯  Turn Bluetooth On")

    local -a items=("←  Back" "$toggle_label" "󰂱  Open Bluetooth Manager")
    if [[ "$powered" == "yes" ]]; then
        while IFS= read -r dev; do
            [[ -n "$dev" ]] && items+=("󰂯  $dev")
        done < <(bluetoothctl devices Paired 2>/dev/null | cut -d' ' -f2-)
    fi

    choice="$(rofi_menu "󰂯 " "${items[@]}")"
    case "$choice" in
        ""|"←  Back") return 0 ;;
        "󰂲  Turn Bluetooth Off") bluetoothctl power off >/dev/null; refresh_waybar ;;
        "󰂯  Turn Bluetooth On") bluetoothctl power on >/dev/null; refresh_waybar ;;
        "󰂱  Open Bluetooth Manager") blueman-manager >/dev/null 2>&1 & ;;
        󰂯*)
            local mac="${choice#󰂯  }"
            mac="${mac%% *}"
            if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
                bluetoothctl disconnect "$mac" >/dev/null || true
            else
                bluetoothctl connect "$mac" >/dev/null || true
            fi
            refresh_waybar
            ;;
    esac
}

volume_menu() {
    local choice
    choice="$(rofi_menu "󰕾 " \
        "←  Back" \
        "󰝟  Toggle Mute" \
        "󰕾  Volume +10%" \
        "󰖀  Volume -10%" \
        "󰕾  Volume 25%" \
        "󰕾  Volume 50%" \
        "󰕾  Volume 75%" \
        "󰕾  Volume 100%" \
        "󰒓  Open Audio Mixer")"
    case "$choice" in
        "󰝟  Toggle Mute") ~/.config/hypr/scripts/osd volume mute ;;
        "󰕾  Volume +10%") ~/.config/hypr/scripts/osd volume up ;;
        "󰖀  Volume -10%") ~/.config/hypr/scripts/osd volume down ;;
        "󰕾  Volume 25%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.25 ;;
        "󰕾  Volume 50%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.50 ;;
        "󰕾  Volume 75%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.75 ;;
        "󰕾  Volume 100%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 1.00 ;;
        "󰒓  Open Audio Mixer") pavucontrol >/dev/null 2>&1 & ;;
    esac
    refresh_waybar
}

brightness_menu() {
    command -v brightnessctl >/dev/null 2>&1 || return 0
    local choice
    choice="$(rofi_menu "󰃟 " \
        "←  Back" \
        "󰃠  Brightness +10%" \
        "󰃞  Brightness -10%" \
        "󰃟  25%" \
        "󰃟  50%" \
        "󰃟  75%" \
        "󰃠  100%")"
    case "$choice" in
        "󰃠  Brightness +10%") ~/.config/hypr/scripts/osd brightness up ;;
        "󰃞  Brightness -10%") ~/.config/hypr/scripts/osd brightness down ;;
        "󰃟  25%") brightnessctl set 25% >/dev/null ;;
        "󰃟  50%") brightnessctl set 50% >/dev/null ;;
        "󰃟  75%") brightnessctl set 75% >/dev/null ;;
        "󰃠  100%") brightnessctl set 100% >/dev/null ;;
    esac
    refresh_waybar
}

notifications_menu() {
    command -v dunstctl >/dev/null 2>&1 || return 0
    local choice dnd_label
    dnd_label=$([[ "$(dnd_status)" == "On" ]] && echo "󰂚  Resume Notifications" || echo "󰂛  Enable Do Not Disturb")

    choice="$(rofi_menu "󰂚 " \
        "←  Back" \
        "$dnd_label" \
        "󰍉  Show Last Notification" \
        "󰎟  Dismiss Visible Notifications" \
        "󰃢  Clear Notification History")"
    case "$choice" in
        "󰂚  Resume Notifications"|"󰂛  Enable Do Not Disturb")
            ~/.config/hypr/scripts/dnd-toggle
            ;;
        "󰍉  Show Last Notification")
            dunstctl history-pop 2>/dev/null || true
            ;;
        "󰎟  Dismiss Visible Notifications")
            dunstctl close-all 2>/dev/null || true
            ;;
        "󰃢  Clear Notification History")
            dunstctl history-clear 2>/dev/null || true
            ;;
    esac
    refresh_waybar
}

case "${1:-}" in
    --status) print_waybar_status; exit 0 ;;
    --wifi) wifi_menu; exit 0 ;;
    --bluetooth) bluetooth_menu; exit 0 ;;
    --volume) volume_menu; exit 0 ;;
    --brightness) brightness_menu; exit 0 ;;
    --notifications) notifications_menu; exit 0 ;;
esac

while true; do
    menu_items=(
        "󰤨  Wi-Fi          ·  $(wifi_status)"
        "󰂯  Bluetooth      ·  $(bt_status)"
        "󰕾  Volume         ·  $(vol_status)"
        "󰃟  Brightness     ·  $(bright_status)"
        "󰖔  Night Light    ·  $(night_status)"
        "󰂛  Do Not Disturb ·  $(dnd_status)"
        "󰂚  Notifications  ·  $(notif_history_count) saved"
    )

    if bat="$(battery_status 2>/dev/null)"; then
        menu_items+=("󰁹  Battery        ·  ${bat}")
    fi

    menu_items+=(
        "󰸉  Wallpaper      ·  Gallery"
        "󰐥  Power Menu"
    )

    choice="$(rofi_menu " " "${menu_items[@]}")"

    [[ -z "$choice" ]] && break

    case "$choice" in
        󰤨*) wifi_menu ;;
        󰂯*) bluetooth_menu ;;
        󰕾*) volume_menu ;;
        󰃟*) brightness_menu ;;
        󰖔*) ~/.config/hypr/scripts/night-light ;;
        󰂛*) ~/.config/hypr/scripts/dnd-toggle ;;
        󰂚*) notifications_menu ;;
        󰸉*) ~/.config/hypr/scripts/wallpaper-picker >/dev/null 2>&1 & break ;;
        󰐥*) wlogout >/dev/null 2>&1 & break ;;
    esac
done
